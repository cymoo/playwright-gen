# DeepSeek（主模型：推理 / 工具调用 / codegen）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-key
MODEL=openai:deepseek-v4-flash

# Qwen（多模态：仅 --vision 时用于"看截图"，返回文本；DeepSeek 不具备视觉）
QWEN_BASE_URL=https://your-qwen-endpoint/compatible-mode/v1
QWEN_API_KEY=sk-your-qwen-key
QWEN_MODEL=qwen3.7-plus

# v0/v1 单次生成的最大重试轮数
MAX_RETRIES=5
